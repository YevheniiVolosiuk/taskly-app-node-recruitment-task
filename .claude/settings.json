{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm --prefix backend test:*)",
      "Bash(backend/node_modules/.bin/tsc -p backend)",
      "Bash(npm --prefix frontend test:*)",
      "Bash(frontend/node_modules/.bin/tsc -p frontend)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/src/cli/write-guard.ts\""
          }
        ]
      }
    ]
  }
}
